        "what": "External-first user config ($DEVBENCH_CONFIG -> ~/.devbench/config.json, optional gitignored local fallback in repo dev mode) seeded from committed templates/config.example.json storing default work root, archive root, repo aliases, and default agent CLI commands.",
        "why": "Separates personal machine paths and CLI defaults from generic plugin code, shares one config across agy/claude/codex, and survives versioned marketplace cache updates.",
        "ucs": [
          "UC-01",
          "UC-02",
          "UC-03",
          "UC-05",
          "UC-07"
        ],
        "decisions": [
          "D3",
          "D4"
        ],
        "data": [
          {
            "object": "config.json",
            "change": "new external JSON file (schema_version = 1)",
            "migration": "devbench init / config check"
          },
          {
            "object": "config.repos.*",
            "change": "new repo alias map -> {path, base_ref}",
            "migration": "seeded from config.example.json"
          },
          {
            "object": "config.agents.*",
            "change": "new harness argv map -> {argv, resume_argv, capture}",
            "migration": "seeded from config.example.json"
          }
        ],
        "files": [
