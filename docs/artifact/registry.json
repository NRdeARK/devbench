    {
      "id": "CMP-WORKTREE",
      "name": "Worktree manager",
      "c4_level": "L2",
      "status": "new",
      "change": {
        "what": "Sanitizes work slugs for Windows/Unix safety, preflights all target repos, creates central per-task work folders with git worktrees and task branches, guards dirty/untracked/ignored state, and cleanly detaches and archives completed folders.",
        "why": "Isolates parallel multi-repo work in one folder per task and enables safe one-step archiving without breaking Git metadata, hitting Windows file locks, or losing uncommitted edits.",
        "ucs": [
          "UC-02",
          "UC-05",
          "UC-06"
        ],
        "decisions": [
          "D1",
          "D6",
          "D7",
          "D9"
        ],
        "files": [
          {
            "path": "src/worktree.rs",
            "change": "added"
          },
          {
            "path": "src/paths.rs",
            "change": "added"
          },
          {
            "path": "src/archive.rs",
            "change": "added"
          },
          {
            "path": "tests/worktree_tests.rs",
            "change": "added"
          }
        ],
        "diagrams": {
          "before": "diagrams/comp-cmp-worktree-before.svg",
          "after": "diagrams/comp-cmp-worktree-after.svg",
          "flowchart": [
            {
              "title": "Archive safety & lock-release flow",
              "diagram": "diagrams/comp-cmp-worktree-flow-archive.svg"
            }
          ]
        }
      }
    },
    {
      "id": "CMP-STATE",
      "name": "Work state",
      "kind": "store",
      "c4_level": "L2",
