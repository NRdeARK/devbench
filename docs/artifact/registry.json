      "id": "CMP-SYS",
      "name": "devbench",
      "kind": "system",
      "c4_level": "L1",
      "status": "new",
      "change": {
        "what": "Standalone multi-agent plugin and marketplace repository implementing the Dispatcher -> Owner -> (domain) worker hierarchy with central per-task work folders, git worktrees, Herdr sessions, centralized work/AI session state, and one-step archiving.",
        "why": "Replaces manual Herdr pane setup, ad-hoc git worktrees, and lost AI session IDs with one reproducible, cross-agent workflow.",
        "ucs": [
          "UC-01",
          "UC-02",
          "UC-03",
          "UC-04",
          "UC-05",
          "UC-06",
          "UC-07"
        ],
        "decisions": [
          "D1",
          "D2",
          "D3",
          "D4",
          "D5",
          "D6",
          "D7",
          "D8",
          "D9"
        ],
        "waive": {
          "files": "System-level view; the file changes are listed on its L2 containers."
        },
        "diagrams": {
          "before": "diagrams/comp-cmp-sys-before.svg",
          "after": "diagrams/comp-cmp-sys-after.svg"
        }
      }
    },
