        "why": "Gives the Dispatcher one instant central index of every active and archived work without folder scanning, avoids cross-work lock contention, stays outside every git worktree, and survives crashes cleanly.",
        "ucs": [
          "UC-02",
          "UC-03",
          "UC-04",
          "UC-05"
        ],
        "decisions": [
          "D2",
          "D5",
          "D6",
          "D7",
          "D9"
        ],
        "data": [
          {
            "object": "~/.devbench/state/works/<slug>.json",
            "change": "new central per-work state JSON (schema_version = 1)",
            "migration": "created by devbench new"
          },
          {
            "object": "~/.devbench/state/works/<slug>.lock",
            "change": "new per-work advisory file lock for atomic tmp+rename",
            "migration": "managed by src/lock.rs"
          },
          {
            "object": "<archive-root>/<slug>/state.snapshot.json",
            "change": "new frozen read-only copy written during archive",
            "migration": "written by devbench archive"
          }
        ],
        "files": [
          {
            "path": "src/state.rs",
            "change": "added"
          },
          {
            "path": "src/lock.rs",
            "change": "added"
          },
