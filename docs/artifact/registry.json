            },
            {
              "table": "config.agents (map)",
              "status": "new",
              "columns": [
                {
                  "name": "harness",
                  "change": "new",
                  "type": "string (key)",
                  "nullable": false,
                  "default": "-",
                  "meaning": "Agent CLI identifier selectable on spawn.",
                  "samples": [
                    "claude",
                    "codex",
                    "agy"
                  ]
                },
                {
                  "name": "argv",
                  "change": "new",
                  "type": "string[]",
                  "nullable": false,
                  "default": "-",
                  "meaning": "Explicit command array passed directly to hc run (never shell-split; Codex includes --no-daemon).",
                  "samples": [
                    "[\"claude\"]",
                    "[\"codex\", \"--no-daemon\"]",
                    "[\"agy\"]"
                  ]
                },
                {
                  "name": "resume_argv",
                  "change": "new",
                  "type": "string[]",
                  "nullable": true,
                  "default": "NULL",
                  "meaning": "Argv template with {session_id} placeholder used when resuming a stopped session.",
                  "samples": [
                    "[\"claude\", \"--resume\", \"{session_id}\"]",
                    "[\"codex\", \"resume\", \"{session_id}\"]"
                  ]
                },
                {
                  "name": "capture",
                  "change": "new",
                  "type": "enum capture_mode",
                  "nullable": false,
                  "default": "manual",
                  "meaning": "Strategy the adapter uses to obtain a native AI session ID.",
                  "values": [
                    {
                      "value": "preassign",
                      "meaning": "devbench generates a UUID and passes --session-id at launch (Claude)."
                    },
                    {
                      "value": "scan",
                      "meaning": "devbench scans the CLI rollout log matching cwd after launch (Codex)."
                    },
                    {
                      "value": "manual",
                      "meaning": "ID is bound later by user or Dispatcher on resume (agy / generic)."
                    }
                  ],
                  "samples": [
                    "preassign",
                    "scan",
                    "manual"
                  ]
                }
              ],
              "sample_rows": {
                "columns": [
                  "harness",
                  "argv",
                  "resume_argv",
                  "capture"
                ],
                "rows": [
                  [
                    "claude",
