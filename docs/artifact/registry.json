                    "[\"claude\", \"--resume\", \"{session_id}\"]",
                    "preassign"
                  ],
                  [
                    "codex",
                    "[\"codex\", \"--no-daemon\"]",
                    "[\"codex\", \"resume\", \"{session_id}\"]",
                    "scan"
                  ],
                  [
                    "agy",
                    "[\"agy\"]",
                    "NULL",
                    "manual"
                  ]
                ]
              }
            }
          ]
        }
      }
